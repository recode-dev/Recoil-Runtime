+
+static void graph_walk(const Image &img, int snap, int depth, int maxnodes, int words) {
+    if (depth < 1) depth = 1;
+    if (depth > 6) depth = 6;
+    if (maxnodes < 4) maxnodes = 4;
+    if (maxnodes > kGraphMax) maxnodes = kGraphMax;
+    if (words < 4) words = 4;
+    if (words > 128) words = 128;
