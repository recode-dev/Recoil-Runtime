diff --git a/Sources/rcl_vtables.cpp b/Sources/rcl_vtables.cpp
new file mode 100644
index 0000000..818a691
--- /dev/null
+++ b/Sources/rcl_vtables.cpp
@@ -0,0 +1,190 @@
+#include "rcl_vtables.h"
+#include "rcl_classes.h"
+#include "rcl_log.h"
+
+#include <stdlib.h>
+#include <string.h>
+#include <algorithm>
+
+namespace rcl {
+
+namespace {
+
+struct Mh {
+    uint32_t magic;
+    uint32_t cputype;
+    uint32_t cpusubtype;
+    uint32_t filetype;
+    uint32_t ncmds;
+    uint32_t sizeofcmds;
+    uint32_t flags;
+    uint32_t reserved;
+};
+
+struct Lc {
+    uint32_t cmd;
+    uint32_t cmdsize;
+};
+
+struct Seg {
+    uint32_t cmd;
+    uint32_t cmdsize;
+    char segname[16];
+    uint64_t vmaddr;
+    uint64_t vmsize;
+    uint64_t fileoff;
+    uint64_t filesize;
+    int32_t maxprot;
+    int32_t initprot;
+    uint32_t nsects;
+    uint32_t flags;
+};
+
+const uint32_t kLcSegment64 = 0x19;
+const uint32_t kRunMin = 3;
+const uint32_t kRunMax = 400;
+
+struct SegRange {
+    char name[17];
+    uint64_t start;
+    uint64_t end;
+};
+
+bool read_at(const Image &img, uint64_t va, void *dst, size_t n) {
+    return img.read && img.read(img.ctx, va, dst, n);
+}
+
+int collect_segments(const Image &img, SegRange *out, int cap) {
+    Mh mh;
+    if (!read_at(img, img.base, &mh, sizeof(mh))) return 0;
+    if (mh.magic != 0xFEEDFACFu) return 0;
+    int n = 0;
+    uint64_t p = img.base + sizeof(Mh);
+    for (uint32_t c = 0; c < mh.ncmds && n < cap; c++) {
+        Lc lc;
+        if (!read_at(img, p, &lc, sizeof(lc))) break;
+        if (lc.cmdsize == 0) break;
+        if (lc.cmd == kLcSegment64) {
+            Seg sg;
+            if (read_at(img, p, &sg, sizeof(sg))) {
+                for (int i = 0; i < 16; i++) out[n].name[i] = sg.segname[i];
+                out[n].name[16] = 0;
+                out[n].start = sg.vmaddr;
+                out[n].end = sg.vmaddr + sg.vmsize;
+                n++;
+            }
+        }
+        p += lc.cmdsize;
+    }
+    return n;
+}
+
+bool prologue(uint32_t w) {
+    if (w == 0xD503233Fu || w == 0xD503237Fu || w == 0xD65F03C0u || w == 0xD503201Fu) return true;
+    if ((w & 0xFFFFFF1Fu) == 0xD503241Fu) return true;
+    if ((w & 0xFF800000u) == 0xA9800000u && ((w >> 5) & 31u) == 31u) return true;
+    if ((w & 0xFF8003FFu) == 0xD10003FFu) return true;
+    if ((w & 0xFC000000u) == 0x14000000u) return true;
+    return false;
+}
+
+bool is_slot(const Image &img, uint64_t raw, uint64_t text_lo, uint64_t text_hi, uint32_t *first) {
+    uint64_t va = raw & 0xFFFFFFFFFULL;
+    if (va < text_lo || va >= text_hi) return false;
+    uint32_t w = 0;
+    if (!read_at(img, va, &w, sizeof(w))) return false;
+    if (!prologue(w)) return false;
+    if (first) *first = (uint32_t)(va - img.base);
+    return true;
+}
+
+const char *name_for(uint32_t rva) {
+    for (uint32_t i = 0; i < kClassCount; i++)
+        if (kClasses[i].start == rva) return kClasses[i].name;
+    return "-";
+}
+
+}  // namespace
+
+std::vector<VtTable> scan_class_tables(const Image &img) {
+    std::vector<VtTable> out;
+    SegRange segs[64];
+    int ns = collect_segments(img, segs, 64);
+    uint64_t text_lo = 0, text_hi = 0;
+    for (int i = 0; i < ns; i++) {
+        if (strncmp(segs[i].name, "__TEXT", 16) == 0) {
+            text_lo = segs[i].start;
+            text_hi = segs[i].end;
+        }
+    }
+    if (!text_lo) return out;
+
+    for (int i = 0; i < ns; i++) {
+        const char *nm = segs[i].name;
+        if (strncmp(nm, "__DATA_CONST", 16) != 0 && strncmp(nm, "__DATA", 16) != 0) continue;
+        uint64_t va = segs[i].start;
+        while (va + 8 <= segs[i].end) {
+            uint64_t raw = 0;
+            if (!read_at(img, va, &raw, sizeof(raw))) break;
+            uint32_t first = 0;
+            if (!is_slot(img, raw, text_lo, text_hi, &first)) {
+                va += 8;
+                continue;
+            }
+            uint32_t slots = 0;
+            uint64_t p = va;
+            while (p + 8 <= segs[i].end && slots < kRunMax) {
+                uint64_t r2 = 0;
+                if (!read_at(img, p, &r2, sizeof(r2))) break;
+                if (!is_slot(img, r2, text_lo, text_hi, nullptr)) break;
+                slots++;
+                p += 8;
+            }
+            if (slots >= kRunMin) {
+                VtTable t;
+                t.start = (uint32_t)(va - img.base);
+                t.slots = slots;
+                t.first_slot = first;
+                t.seg = segs[i].name;
+                t.name = name_for(t.start);
+                out.push_back(t);
+            }
+            va = p > va ? p : va + 8;
+        }
+    }
+    std::sort(out.begin(), out.end(), [](const VtTable &a, const VtTable &b) { return a.start < b.start; });
+    return out;
+}
+
+void dump_class_tables(const Image &img) {
+    std::vector<VtTable> t = scan_class_tables(img);
+    const char *sl = getenv("RCL_VTABLE_SLOTS");
+    const bool show_slots = sl && *sl == '1';
+    uint64_t total = 0;
+    for (auto &x : t) total += x.slots;
+
+    RCL_LOGLN("[class tables] tables=%zu slots=%llu  (every class table in the image)",
+              t.size(), (unsigned long long)total);
+    for (auto &x : t) {
+        RCL_LOGLN("  vt=0x%06x slots=%3u seg=%-13s name=%s", x.start, x.slots, x.seg, x.name);
+        if (!show_slots) continue;
+        for (uint32_t s = 0; s < x.slots; s++) {
+            uint64_t r = 0;
+            if (!read_at(img, img.base + x.start + s * 8, &r, sizeof(r))) break;
+            RCL_LOG("%s0x%06x", s ? " " : "      ", (unsigned)((r & 0xFFFFFFFFFULL) - img.base));
+            if ((s + 1) % 8 == 0) RCL_LOGLN("");
+        }
+        RCL_LOGLN("");
+    }
+
+    std::vector<VtTable> big = t;
+    std::sort(big.begin(), big.end(), [](const VtTable &a, const VtTable &b) { return a.slots > b.slots; });
+    RCL_LOGLN("   -- widest tables --");
+    for (size_t i = 0; i < big.size() && i < 16; i++)
+        RCL_LOGLN("   vt=0x%06x slots=%3u", big[i].start, big[i].slots);
+    int named = 0;
+    for (auto &x : t) if (strcmp(x.name, "-") != 0) named++;
+    RCL_LOGLN("   -- named from the data-class table: %d, unnamed: %zu --", named, t.size() - named);
+}
+
+}
diff --git a/Sources/rcl_vtables.h b/Sources/rcl_vtables.h
new file mode 100644
index 0000000..7188a36
--- /dev/null
+++ b/Sources/rcl_vtables.h
@@ -0,0 +1,23 @@
+#ifndef RCL_VTABLES_H
+#define RCL_VTABLES_H
+
+#include "rcl_scan.h"
+
+#include <vector>
+
+namespace rcl {
+
+struct VtTable {
+    uint32_t start = 0;
+    uint32_t slots = 0;
+    uint32_t first_slot = 0;
+    const char *seg = "";
+    const char *name = "-";
+};
+
+std::vector<VtTable> scan_class_tables(const Image &img);
+void dump_class_tables(const Image &img);
+
+}
+
+#endif
