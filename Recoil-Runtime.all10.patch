+bool class_from_text(const char *s, char *out, size_t cap) {
+    for (const char *p = s; *p; p++) {
+        if (*p < 'A' || *p > 'Z') continue;
+        if (p != s) {
+            char b = p[-1];
+            if ((b >= 'A' && b <= 'Z') || (b >= 'a' && b <= 'z') || (b >= '0' && b <= '9') ||
+                b == '_' || b == ':')
+                continue;
+        }
+        const char *q = p;
+        while ((*q >= 'A' && *q <= 'Z') || (*q >= 'a' && *q <= 'z') || (*q >= '0' && *q <= '9') ||
+               *q == '_')
+            q++;
+        if (q - p < 3 || q[0] != ':' || q[1] != ':') continue;
+        const char *r = q + 2;
+        if (!((*r >= 'A' && *r <= 'Z') || (*r >= 'a' && *r <= 'z') || *r == '~')) continue;
+        size_t n = (size_t)(q - p);
+        if (n >= cap) n = cap - 1;
+        memcpy(out, p, n);
+        out[n] = 0;
+        return true;
+    }
+    return false;
+}
