+                if (tables[t].start == sw[i].vts[k]) slots = tables[t].slots;
+            fprintf(f, "| %s | %s | `%#x` | %u |\n", sw[i].lo, sw[i].hi, sw[i].vts[k], slots);
+            total++;
+        }
+    fprintf(f, "\n%zu tables carry an order constraint\n", total);
+    fclose(f);
+}
