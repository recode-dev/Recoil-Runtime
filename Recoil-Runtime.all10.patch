+                le_off = sg.fileoff;
+                le_va = sg.vmaddr;
+            }
+        } else if (lc.cmd == kLcFunctionStarts) {
+            struct FsCmd {
+                uint32_t cmd;
+                uint32_t cmdsize;
+                uint32_t dataoff;
+                uint32_t datasize;
+            } fs;
+            if (at(img, p, &fs, sizeof(fs))) {
+                dataoff = fs.dataoff;
+                datasize = fs.datasize;
+            }
+        }
+        p += lc.cmdsize;
+    }
+    if (!datasize || dataoff < le_off) return false;
+    uint64_t va = le_va + (dataoff - le_off) + L.slide;
+    uint64_t end = va + datasize;
+    uint32_t rva = 0;
+    while (va < end) {
+        uint8_t b = 0;
+        uint32_t shift = 0, delta = 0;
+        bool ok = false;
+        for (;;) {
+            if (!at(img, va, &b, 1)) return !out.empty();
+            va += 1;
+            delta |= (uint32_t)(b & 0x7Fu) << shift;
+            shift += 7;
+            if (!(b & 0x80u)) {
+                ok = true;
+                break;
+            }
+            if (shift > 28) break;
+        }
+        if (!ok || !delta) break;
+        rva += delta;
+        out.push_back(rva);
     }
+    return !out.empty();
 }
 
