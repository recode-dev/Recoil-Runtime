+bool class_specific_string(const char *s) {
+    size_t n = strlen(s);
+    if (n == 0 || s[0] == '%') return false;
+    if (n >= 16) return g_unique_str.find(std::string(s)) != g_unique_str.end();
+    if (strstr(s, "::")) return true;
+    return false;
+}
