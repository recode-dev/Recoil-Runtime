From b18ca2d4da98297cc5166685ab311a807323ac04 Mon Sep 17 00:00:00 2001
From: recode <dev@recode>
Date: Mon, 12 Oct 2026 01:24:55 +0800
Subject: [PATCH] colmap: single columns/map-all.md; raw read via
 mach_vm_read_overwrite (no wild deref)

---
 src/core/rcl_dump.cpp | 113 +++++++++++++++++++++++++++++-------------
 src/core/rcl_main.cpp |  17 ++++---
 2 files changed, 90 insertions(+), 40 deletions(-)

diff --git a/src/core/rcl_dump.cpp b/src/core/rcl_dump.cpp
index 01f8a3c..2eb9b3a 100644
--- a/src/core/rcl_dump.cpp
+++ b/src/core/rcl_dump.cpp
@@ -7,6 +7,7 @@
 
 #include <set>
 #include <string>
+#include <string.h>
 #include <vector>
 
 namespace rcl
@@ -39,7 +40,8 @@ void dump_index(const Image &img)
     std::string t = "# Recoil-Runtime dump\n\n";
     t += out_fmt("- base: `0x%llx`\n", (unsigned long long)img.base);
     t += out_fmt("- image_vmsize: `0x%llx`\n\n", (unsigned long long)img.image_vmsize);
-    t += "sections: `anchors`, `properties`, `columns`, `vtables`, `ctors`, `targets`, `missing`\n";
+    t += "sections: `anchors`, `properties`, `columns/map-all`, `vtables`, `ctors`, `targets`,"
+         " `missing`\n";
     out_write_root("index", t);
 }
 
@@ -244,25 +246,25 @@ void dump_missing(const Image &img)
     RCL_LOGLN("[dump] missing %zu", sizeof kMiss / sizeof kMiss[0]);
 }
 
-static bool rdany(const Image &img, uint64_t va, void *dst, size_t n)
+static bool rdany_2(const Image &img, uint64_t va, void *dst, size_t n)
 {
     if (img.read_raw)
         return img.read_raw(img.ctx, va, dst, n);
     return img.read(img.ctx, va, dst, n);
 }
 
-static bool win_ok(uint64_t va)
+static bool win_ok_2(uint64_t va)
 {
-    return va >= 0x100000000ULL && va < 0x400000000ULL;
+    return va >= 0x100000000ULL && va < 0x400000000ULL && (va & 7) == 0;
 }
 
-static std::string rstr(const Image &img, uint64_t va, size_t maxn)
+static std::string rstr_2(const Image &img, uint64_t va, size_t maxn)
 {
     char buf[64];
     size_t n = maxn < sizeof buf - 1 ? maxn : sizeof buf - 1;
-    if (!win_ok(va) || n < 2)
+    if (!win_ok_2(va) || n < 2)
         return std::string();
-    if (!rdany(img, va, buf, n))
+    if (!rdany_2(img, va, buf, n))
         return std::string();
     buf[n] = 0;
     for (size_t i = 0; i < n; i++)
@@ -283,20 +285,44 @@ static std::string scstring(const Image &img, uint64_t sc)
 {
     uint32_t len = 0;
     uint64_t data = 0;
-    if (!rdany(img, sc + 4, &len, 4) || len == 0 || len > 64)
+    if (!rdany_2(img, sc + 4, &len, 4) || len == 0 || len > 64)
         return std::string();
     if (len <= 7)
-        return rstr(img, sc + 8, len);
-    if (!rdany(img, sc + 8, &data, 8) || !data)
+        return rstr_2(img, sc + 8, len);
+    if (!rdany_2(img, sc + 8, &data, 8) || !data)
         return std::string();
-    return rstr(img, data, len);
+    return rstr_2(img, data, len);
+}
+
+static std::string name_at_2(const Image &img, uint64_t e)
+{
+    uint64_t lenw = 0;
+    uint64_t v = 0;
+    uint32_t len = 0;
+    unsigned char b[8];
+    if (!rdany_2(img, e + 0x10, &lenw, 8))
+        return std::string();
+    len = (uint32_t)(lenw & 0xFFFFFFFFULL);
+    if (len == 0 || len > 64)
+        return std::string();
+    if (!rdany_2(img, e + 0x18, &v, 8) || v == 0)
+        return std::string();
+    if (len > 7)
+        return rstr_2(img, v, len);
+    memcpy(b, &v, sizeof b);
+    for (uint32_t i = 0; i < len; i++)
+    {
+        if (b[i] < 32 || b[i] > 127)
+            return std::string();
+    }
+    return std::string((const char *)b, len);
 }
 
 void dump_colmap(const Image &img, const Seeds &s)
 {
     const uint64_t arr = img.base + 0x1154f08ULL;
-    std::string root = out_fmt("# column map\n\n- arr: `0x%llx`\n\n", (unsigned long long)arr);
-    std::string idx = "# tables\n\n";
+    std::string idx;
+    std::vector<std::string> bodies;
     for (int i = 0; i < 157; i++)
     {
         uint64_t t = 0;
@@ -311,18 +337,18 @@ void dump_colmap(const Image &img, const Seeds &s)
         uint64_t c = 0;
         std::string nm;
         std::string body;
-        if (!rdany(img, arr + (uint64_t)i * 8, &t, 8) || !t)
+        if (!rdany_2(img, arr + (uint64_t)i * 8, &t, 8) || !t)
             continue;
-        rdany(img, t, &vt, 8);
-        rdany(img, t + 0x50, &ti, 8);
-        if (!rdany(img, t + 0x58, &csv, 8) || !csv)
+        rdany_2(img, t, &vt, 8);
+        rdany_2(img, t + 0x50, &ti, 8);
+        if (!rdany_2(img, t + 0x58, &csv, 8) || !csv)
             continue;
-        rdany(img, csv, &buckets, 8);
-        rdany(img, csv + 8, &cnt, 8);
-        rdany(img, csv + 0x18, &rows, 8);
-        if (rdany(img, csv + 0x58, &a, 8) && a && rdany(img, a + 0x18, &b, 8) && b)
+        rdany_2(img, csv, &buckets, 8);
+        rdany_2(img, csv + 8, &cnt, 8);
+        rdany_2(img, csv + 0x18, &rows, 8);
+        if (rdany_2(img, csv + 0x58, &a, 8) && a && rdany_2(img, a + 0x18, &b, 8) && b)
         {
-            if (rdany(img, b + 0x30, &c, 8))
+            if (rdany_2(img, b + 0x30, &c, 8))
                 nm = scstring(img, b + 0x30);
         }
         body = out_fmt("# tbl %d\n\n- table `0x%llx` vtable `0x%llx` idx %llu\n- csv `0x%llx`\n"
@@ -330,17 +356,17 @@ void dump_colmap(const Image &img, const Seeds &s)
                        i, (unsigned long long)t, (unsigned long long)vt, (unsigned long long)ti,
                        (unsigned long long)csv, (unsigned long long)buckets, (unsigned long long)cnt,
                        (unsigned long long)rows, nm.c_str());
-        if (win_ok(buckets) && cnt > 0 && cnt <= 4096)
+        if (win_ok_2(buckets) && cnt > 0 && cnt <= 4096)
         {
             size_t shown = 0;
             for (uint64_t k = 0; k < cnt && shown < 48; k++)
             {
                 uint64_t e = 0;
-                if (!rdany(img, buckets + k * 8, &e, 8) || !e)
+                if (!rdany_2(img, buckets + k * 8, &e, 8) || !e)
                     continue;
                 for (int chain = 0; chain < 8 && shown < 48; chain++)
                 {
-                    if (!win_ok(e))
+                    if (!win_ok_2(e))
                         break;
                     body += out_fmt("\n## bucket %llu entry `0x%llx`\n\n", (unsigned long long)k,
                                     (unsigned long long)e);
@@ -348,30 +374,49 @@ void dump_colmap(const Image &img, const Seeds &s)
                     {
                         uint64_t w = 0;
                         std::string st;
-                        if (!rdany(img, e + (uint64_t)q * 8, &w, 8))
+                        if (!rdany_2(img, e + (uint64_t)q * 8, &w, 8))
                             break;
-                        st = rstr(img, w, 40);
+                        st = rstr_2(img, w, 40);
                         body += out_fmt("- `+0x%02x` = `0x%llx`%s%s%s\n", q * 8,
                                         (unsigned long long)w, st.empty() ? "" : "  \"",
                                         st.empty() ? "" : st.c_str(), st.empty() ? "" : "\"");
                     }
+                    {
+                        std::string en = name_at_2(img, e);
+                        uint64_t colw = 0;
+                        if (!en.empty())
+                        {
+                            rdany_2(img, e + 0x20, &colw, 8);
+                            body += out_fmt("- name \"%s\"  col %llu\n", en.c_str(),
+                                            (unsigned long long)(colw & 0xFFFFFFFFULL));
+                        }
+                    }
                     shown++;
                     {
                         uint64_t nxt = 0;
-                        if (!rdany(img, e, &nxt, 8) || !nxt || nxt == e)
+                        if (!rdany_2(img, e, &nxt, 8) || !nxt || nxt == e)
                             break;
                         e = nxt;
                     }
                 }
             }
         }
-        out_write("columns", out_fmt("map-%d", i).c_str(), body);
-        idx += out_fmt("- [%d] `0x%llx` n=%llu name \"%s\"\n", i, (unsigned long long)csv,
-                       (unsigned long long)cnt, nm.c_str());
+        bodies.push_back(body);
+        idx += out_fmt("- [%d] `0x%llx` n=%llu rows `0x%llx` name \"%s\"\n", i,
+                       (unsigned long long)csv, (unsigned long long)cnt, (unsigned long long)rows,
+                       nm.c_str());
+    }
+    std::string all = out_fmt("# column map\n\n- arr: `0x%llx`\n- tables: %zu\n\n## tables\n\n",
+                              (unsigned long long)arr, bodies.size());
+    all += idx;
+    all += "\n";
+    for (size_t i = 0; i < bodies.size(); i++)
+    {
+        all += "\n";
+        all += bodies[i];
     }
-    out_write("columns", "map-index", idx);
-    out_write("columns", "map-root", root);
-    RCL_LOGLN("[dump] column map");
+    out_write("columns", "map-all", all);
+    RCL_LOGLN("[dump] column map %zu tables", bodies.size());
 }
 
 void dump_all(const Image &img, const Seeds &s)
diff --git a/src/core/rcl_main.cpp b/src/core/rcl_main.cpp
index 0fe3a02..2899e8c 100644
--- a/src/core/rcl_main.cpp
+++ b/src/core/rcl_main.cpp
@@ -16,6 +16,8 @@
 #if defined(__APPLE__)
 #include <mach-o/dyld.h>
 #include <mach-o/loader.h>
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
 #include <unistd.h>
 #include <pthread.h>
 #endif
@@ -40,16 +42,19 @@ static bool live_read(void *ctx, uint64_t va, void *dst, size_t n)
     return true;
 }
 
-static bool raw_read(void *, uint64_t va, void *dst, size_t n)
+static bool raw_read_2(void *, uint64_t va, void *dst, size_t n)
 {
-    // heap objects live far above the image; keep the window tight so a bogus
-    // value cannot turn into a wild dereference
+    mach_vm_size_t got = 0;
     if (n == 0 || n > 0x10000 || va < 0x100000000ULL || va >= 0x400000000ULL)
         return false;
+    if ((va & 7) != 0)
+        return false;
     if (va + n < va)
         return false;
-    memcpy(dst, (const void *)(uintptr_t)va, n);
-    return true;
+    if (mach_vm_read_overwrite(mach_task_self(), (mach_vm_address_t)va, (mach_vm_size_t)n,
+                               (mach_vm_address_t)(uintptr_t)dst, &got) != KERN_SUCCESS)
+        return false;
+    return got == (mach_vm_size_t)n;
 }
 
 static uint64_t text_vmsize(const struct mach_header_64 *h)
@@ -115,7 +120,7 @@ static int gather_images(std::vector<Loaded> &out, bool verbose)
         l.img.vmsize = ts;
         l.img.image_vmsize = macho_image_size(h);
         l.img.read = live_read;
-        l.img.read_raw = raw_read;
+        l.img.read_raw = raw_read_2;
         l.img.ctx = nullptr;
         l.name = name;
         l.text = ts;
-- 
2.43.0

