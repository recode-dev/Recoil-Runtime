+inline const char *name_for_rva(uint32_t rva) {
+    uint32_t lo = 0, hi = kNameCount;
+    while (lo < hi) {
+        uint32_t mid = (lo + hi) / 2;
+        if (kNames[mid].rva == rva) return kNames[mid].name;
+        if (kNames[mid].rva < rva) lo = mid + 1; else hi = mid;
+    }
+    return "-";
+}
